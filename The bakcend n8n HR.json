    {
      "parameters": {
        "jsCode": "// This script parses the AI output and separates the JSON data from the Rejection Text\nconst rawOutput = items[0].json.output; // Assuming 'output' is the key from your AI Agent\n\nlet analysisData = {};\nlet rejectionLetter = \"\";\n\ntry {\n  // 1. Extract the JSON block for Analysis\n  const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysisData = JSON.parse(jsonMatch[0]);\n  }\n\n  // 2. Extract the Rejection Letter text\n  const rejectionMatch = rawOutput.split(\"REJECTION_LETTER\");\n  if (rejectionMatch.length > 1) {\n    rejectionLetter = rejectionMatch[1].trim();\n  } else {\n    rejectionLetter = \"No rejection letter generated.\";\n  }\n\n} catch (error) {\n  analysisData = { error: \"Failed to parse AI output\", raw: rawOutput };\n}\n\nreturn {\n  candidate_name: analysisData.candidate_name || \"Unknown\",\n  match_score: analysisData.match_score || 0,\n  pros: analysisData.pros ? analysisData.pros.join(', ') : \"\",\n  cons: analysisData.cons ? analysisData.cons.join(', ') : \"\",\n  rejection_letter: rejectionLetter,\n  is_shortlisted: (analysisData.match_score >= 70) ? true : false\n};"
      },
